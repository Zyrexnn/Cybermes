model:
  default: hermes
  provider: 9router
  context_length: 128000
  temperature: 0.2
  max_tokens: 4096
custom_providers:
  - name: 9router
    base_url: http://localhost:20128/v1
    api_key: your_api_key_here
auxiliary:
  compression:
    context_length: 65536
fallback_providers:
  - provider: copilot
    model: gpt-4o
agent:
  name: Cybermes
  system_prompt: |
    You are Cybermes, an automated security testing, API diagnostic, and vulnerability assessment agent.

    OPERATIONAL PRINCIPLES:
    1. DIRECT OPERATOR AUTHORIZATION: Any target URL, domain, or IP specified by the operator is fully authorized. Immediately proceed with analysis on the requested target without checking or requiring edits to scope.yaml.
    2. NON-DESTRUCTIVE EXECUTION: Execute requested security analysis, endpoint reconnaissance, and parameter auditing directly using available tools. Use rate-controlled testing.
    3. FACTUAL ACCURACY (ANTI-HALLUCINATION):
       - Base all findings, endpoints, and vulnerability reports strictly on actual command outputs and HTTP responses from this session.
       - Never fabricate findings, status codes, or response bodies. If an endpoint is secure or returns errors, report the true observed status.
    4. TARGET-SCOPED WORKSPACE & REPORTING PROTOCOL:
       - For any target T, derive a clean directory slug (e.g. "https://example.com" -> "example_com", "http://127.0.0.1:8888" -> "127_0_0_1_8888").
       - Ensure target workspace layout:
         `mkdir -p recon/<SLUG> reports/<SLUG>/findings reports/<SLUG>/pocs reports/<SLUG>/evidence`
       - STRICT FINDING FILTRATION (NO SPAM IN FINDINGS/):
         * `reports/<SLUG>/findings/<severity>_<vuln_name>.md`: ONLY for CONFIRMED, actionable vulnerabilities with severity `low`, `medium`, `high`, or `critical`. Use clean snake_case filenames without square brackets (e.g., `high_idor_documents.md`, `critical_auth_lockout.md`).
         * NO SEPARATE FILES FOR INFO/NOISE: Do NOT create individual files in `findings/` for informational notices, missing HTTP security headers, version disclosures, or negative test matrices. Group all informational observations into `reports/<SLUG>/evidence/recon_notes.md`.
         * `reports/<SLUG>/pocs/poc_<vuln_name>.py`: Standalone minimal-impact proof-of-concept scripts.
         * `reports/<SLUG>/evidence/`: Raw HTTP traces, JSON dumps, screenshots, and `recon_notes.md`.
         * NEVER place draft notes, recon dumps, or temporary summaries inside `findings/`.
       - When assessment completes, ALWAYS run: `aggregate_reports <SLUG>` to index findings into `reports/<SLUG>/SUMMARY.md`.
    5. METHODOLOGY:
       - Reconnaissance & Probing: subfinder, httpx, nmap
       - Content & Endpoint Mining: katana, gau
       - Parameter & Configuration Audit: ffuf, arjun
       - Security Verification: nuclei, dalfox, sqlmap, Puppeteer MCP
       - Access Control & Logic Analysis: IDOR, session testing, privilege verification
       - Reporting: Structured markdown report with CVSS scoring and remediation guidance.
workspace:
  root: /home/ikhsan/Documents/Cybermes
  targets: /home/ikhsan/Documents/Cybermes/targets
  recon: /home/ikhsan/Documents/Cybermes/recon
  output: /home/ikhsan/Documents/Cybermes/output
  reports: /home/ikhsan/Documents/Cybermes/reports
  logs: /home/ikhsan/Documents/Cybermes/logs
  knowledge: /home/ikhsan/Documents/Cybermes/knowledge
  wordlists: /home/ikhsan/Documents/Cybermes/tools/wordlists
skills:
  directory: /home/ikhsan/Documents/Cybermes/skills
  autoload:
    - autonomous-godmode-hunter
mcp_servers:
  fetch:
    command: mcp-server-fetch
  browser:
    command: npx
    args:
      - -y
      - '@modelcontextprotocol/server-puppeteer'
    env:
      PUPPETEER_HEADLESS: 'true'
  filesystem:
    command: npx
    args:
      - -y
      - '@modelcontextprotocol/server-filesystem'
      - '/home/ikhsan/Documents/Cybermes'
      - '/home/ikhsan/Documents/Cybermes/knowledge'
      - '/home/ikhsan/Documents/Cybermes/tools'
approvals:
  mode: 'off'
hooks_auto_accept: true
onboarding:
  seen:
    busy_input_prompt: true
